{
  "name": "mobile-mp3-player",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "prebuild": "expo prebuild",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:prod:android": "eas build --profile production-apk --platform android --clear-cache",
    "build:prod:ios": "eas build --profile production --platform ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^56.0.0-preview.11",
    "expo-blur": "~56.0.3",
    "expo-dev-client": "~56.0.9",
    "expo-document-picker": "~56.0.3",
    "expo-file-system": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.6",
    "expo-router": "~56.1.4",
    "expo-splash-screen": "~56.0.7",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.4",
    "lucide-react-native": "^1.16.0",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.0",
    "react-native-svg": "15.15.4",
    "react-native-track-player": "^4.1.2",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
